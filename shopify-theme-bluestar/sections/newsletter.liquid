{%- assign s = section.settings -%}
<section class="section">
  <div class="container">
    <div class="newsletter-card{% if s.image == blank %} no-image{% endif %}{% if s.image_position == 'right' %} media-right{% endif %}">
      {%- if s.image != blank -%}
        <div class="newsletter-media">{{ s.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(max-width: 920px) 92vw, 50vw', loading: 'lazy' }}</div>
      {%- endif -%}
      <div class="newsletter-copy">
        {%- if s.eyebrow != blank -%}<span class="eyebrow" style="color:var(--sky-100)">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="newsletter-text">{{ s.text }}</div>{%- endif -%}
        {% render 'newsletter-form', id: section.id, button: s.button_label %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't miss out on sales!" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Subscribe with your email today!</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}

<div class="page-head container"><h1>{{ blog.title }}</h1></div>
<section class="section" style="padding-top:36px">
  <div class="container">
    {%- paginate blog.articles by 9 -%}
      <div class="articles-grid cols-grid"{% render 'grid-cols', desktop: section.settings.columns_desktop, mobile: section.settings.columns_mobile %}>
        {%- for article in blog.articles -%}
          <a class="article-card" href="{{ article.url }}">
            {%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- endif -%}
            <div class="product-body">
              <span class="article-meta">{{ article.published_at | time_tag: format: 'date' }}</span>
              <h3>{{ article.title }}</h3>
              <p class="product-desc">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ]
}
{% endschema %}

<a class="article-card" href="{{ article.url }}">
  {%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(max-width: 920px) 92vw, 33vw', loading: 'lazy', alt: article.title }}{%- endif -%}
  <div class="product-body">
    {%- if show_date != false -%}<span class="article-meta">{{ article.published_at | time_tag: format: 'date' }}</span>{%- endif -%}
    <h3>{{ article.title }}</h3>
    {%- if show_excerpt -%}<p class="product-desc">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>{%- endif -%}
  </div>
</a>

{%- comment -%}
  Store logo (same file the previous theme used, picked in Theme settings → Brand),
  optionally followed by the two-line wordmark. Pass on_dark: true in the footer.
{%- endcomment -%}
{%- liquid
  assign logo = settings.logo
  if on_dark and settings.logo_footer != blank
    assign logo = settings.logo_footer
  endif
  assign show_text = true
  if logo != blank and settings.logo_show_text == false
    assign show_text = false
  endif
-%}
{%- if logo != blank -%}
  {%- assign logo_w = logo.aspect_ratio | times: settings.logo_height | round -%}
  {{ logo | image_url: height: 240 | image_tag: height: settings.logo_height, width: logo_w, alt: shop.name, class: 'brand-logo', loading: 'eager' }}
{%- endif -%}
{%- if show_text -%}
  <span>
    <span class="brand-name"{% if on_dark %} style="color:#fff"{% endif %}>{{ settings.brand_name | default: shop.name }}</span>
    {%- if settings.brand_sub != blank -%}<span class="brand-sub">{{ settings.brand_sub }}</span>{%- endif -%}
  </span>
{%- endif -%}

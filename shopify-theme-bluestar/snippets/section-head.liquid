{%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
  <div class="section-head">
    {%- if s.eyebrow != blank -%}<span class="eyebrow"{% if light %} style="color:var(--sky-100)"{% endif %}>{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}{%- assign htag = tag | default: 'h2' -%}<{{ htag }}>{{ s.heading }}</{{ htag }}>{%- endif -%}
    {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
  </div>
{%- endif -%}

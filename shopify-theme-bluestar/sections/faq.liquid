<section class="section" id="{{ section.settings.anchor }}">
  <div class="container">
    {% render 'section-head', s: section.settings %}
    <div class="faq-list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte" style="color:var(--muted);font-size:0.92rem;margin-top:10px">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.contact != blank -%}
      <div class="faq-contact">{{ section.settings.contact }}</div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.faq_schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "faq"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, answered"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "richtext",
      "id": "contact",
      "label": "Contact line",
      "default": "<p>Still have questions? Call us at <strong>973-742-0216</strong> or <a href=\"/pages/contact\">send us a message</a> — Se Habla Español.</p>"
    },
    {
      "type": "checkbox",
      "id": "faq_schema",
      "label": "Add FAQ structured data for Google",
      "default": true,
      "info": "Use on one FAQ per page."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you deliver to my area?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We cover northern New Jersey plus all five NYC boroughs.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}

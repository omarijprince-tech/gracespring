<section class="section">
  <div class="container">
    {% render 'section-head', s: section.settings %}
    {{ section.settings.custom_liquid }}
  </div>
</section>

{% schema %}
{
  "name": "Custom code / widget",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "liquid", "id": "custom_liquid", "label": "Code", "info": "Paste embed codes (reviews widget, map, etc.)." }
  ],
  "presets": [ { "name": "Custom code / widget" } ]
}
{% endschema %}

<div class="page-head container"><h1>{{ 'collections.all_title' | t }}</h1></div>
<section class="section" style="padding-top:36px">
  <div class="container articles-grid cols-grid"{% render 'grid-cols', desktop: section.settings.columns_desktop, mobile: section.settings.columns_mobile %}>
    {%- for collection in collections -%}
      <a class="article-card" href="{{ collection.url }}">
        {%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- endif -%}
        <div class="product-body"><h3>{{ collection.title }}</h3><span class="article-meta">{{ collection.products_count }} {{ 'collections.products' | t }}</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ]
}
{% endschema %}

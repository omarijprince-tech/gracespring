<div class="container contact-layout">
  <div class="panel">
    <h1 class="contact-title">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="contact-lede rte">{{ page.content }}</div>{%- endif -%}
    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}<p class="form-msg ok">{{ 'contact.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form-msg err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form-grid">
        <div class="field"><label for="c-name">{{ 'contact.name' | t }}</label><input id="c-name" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="field"><label for="c-phone">{{ 'contact.phone' | t }}</label><input id="c-phone" name="contact[phone]" type="tel" autocomplete="tel" value="{{ form.phone }}"></div>
        <div class="field full"><label for="c-email">{{ 'contact.email' | t }}</label><input id="c-email" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email }}"></div>
        <div class="field full"><label for="c-body">{{ 'contact.message' | t }}</label><textarea id="c-body" name="contact[body]" required>{{ form.body }}</textarea></div>
      </div>
      <button class="btn btn-primary" type="submit" style="margin-top:16px">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
  <aside class="panel contact-aside">
    <h2>{{ section.settings.aside_heading }}</h2>
    <div class="rte contact-links">{{ section.settings.aside }}</div>
  </aside>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "aside_heading", "label": "Sidebar heading", "default": "Other ways to reach us" },
    { "type": "richtext", "id": "aside", "label": "Sidebar", "default": "<p>Phone: <a href=\"tel:9737420216\">973-742-0216</a></p><p>527 E 39th St, Paterson, NJ 07504</p><p>Se Habla Español</p>" }
  ]
}
{% endschema %}

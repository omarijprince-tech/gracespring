<section class="section delivery newsletter-band">
  <div class="container">
    {% render 'section-head', s: section.settings, light: true %}
    {%- form 'customer', class: 'zip-form newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="zip-result ok" style="flex-basis:100%;text-align:center">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="sr-only" for="nl-{{ section.id }}">{{ 'contact.email' | t }}</label>
        <input id="nl-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
        <button class="btn btn-light" type="submit">{{ section.settings.button_label | default: 'Subscribe' }}</button>
        {%- if form.errors -%}<p class="zip-result no" style="flex-basis:100%;text-align:center">{{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't miss out on sales!" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe with your email today!" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}

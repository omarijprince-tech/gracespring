<section class="hero" id="{{ section.settings.anchor | default: 'top' }}">
  <div class="container hero-inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h1>
      {%- if section.settings.text != blank -%}<p class="hero-sub">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero-ctas">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.button_link | default: '#shop' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn-outline" href="{{ section.settings.button2_link | default: '#delivery' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="hero-chips">
          {%- for block in section.blocks -%}
            <span class="chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="hero-visual photo">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1120 | image_tag: widths: '400, 560, 800, 1120', sizes: '(max-width: 920px) 92vw, 560px', loading: 'eager', fetchpriority: 'high' }}
      {%- else -%}
        <img src="{{ 'hero-bottle.png' | asset_url }}" alt="{{ shop.name }}" width="522" height="982" style="max-width:300px;box-shadow:none;margin:0 auto" loading="eager">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "5-gallon water delivery · NJ & NYC" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pure, clean water," },
    { "type": "text", "id": "heading_accent", "label": "Heading (accent color)", "default": "delivered to your door." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Blue Star brings 5-gallon bottles of purified, spring, and alkaline water to homes and offices across New Jersey and the five boroughs. Order online — we confirm your route and remind you every month." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Start Your Order" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Check Your Area" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "top" }
  ],
  "blocks": [
    { "type": "chip", "name": "Chip", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "🚚 Next-day local delivery" } ] }
  ],
  "presets": [ { "name": "Hero", "blocks": [ { "type": "chip" } ] } ]
}
{% endschema %}

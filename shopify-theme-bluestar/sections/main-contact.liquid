<div class="container contact-layout">
  <div class="panel">
    <h1 class="contact-title">{{ page.title }}</h1>
    {%- if section.settings.intro != blank -%}<div class="contact-lede rte">{{ section.settings.intro }}</div>{%- endif -%}
    {%- if page.content != blank -%}<div class="contact-lede rte">{{ page.content }}</div>{%- endif -%}
    {%- if section.settings.show_form -%}
    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}<p class="form-msg ok">{{ 'contact.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form-msg err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form-grid">
        <div class="field"><label for="c-name">{{ 'contact.name' | t }}</label><input id="c-name" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="field"><label for="c-phone">{{ 'contact.phone' | t }}</label><input id="c-phone" name="contact[phone]" type="tel" autocomplete="tel" value="{{ form.phone }}"></div>
        <div class="field full"><label for="c-email">{{ 'contact.email' | t }}</label><input id="c-email" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email }}"></div>
        <div class="field full"><label for="c-body">{{ 'contact.message' | t }}</label><textarea id="c-body" name="contact[body]" required>{{ form.body }}</textarea></div>
      </div>
      <button class="btn btn-primary" type="submit" style="margin-top:16px">{{ 'contact.send' | t }}</button>
    {%- endform -%}
    {%- elsif section.settings.button_label != blank -%}
      <a class="btn btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  <aside class="panel contact-aside">
    <h2>{{ section.settings.aside_heading }}</h2>
    <div class="rte contact-links">{{ section.settings.aside }}</div>
    {%- if section.settings.aside_button_label != blank or section.settings.aside_button2_label != blank -%}
      <div class="hero-ctas contact-actions">
        {%- if section.settings.aside_button_label != blank -%}<a class="btn btn-primary" href="{{ section.settings.aside_button_link }}">{{ section.settings.aside_button_label }}</a>{%- endif -%}
        {%- if section.settings.aside_button2_label != blank -%}<a class="btn btn-outline" href="{{ section.settings.aside_button2_link }}">{{ section.settings.aside_button2_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </aside>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show contact form",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button under the intro (when the form is hidden)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "aside_heading",
      "label": "Sidebar heading",
      "default": "Other ways to reach us"
    },
    {
      "type": "richtext",
      "id": "aside",
      "label": "Sidebar",
      "default": "<p>Phone: <a href=\"tel:9737420435\">973-742-0435</a></p><p>527 E 39th St, Paterson, NJ 07504</p><p>Se Habla Español</p>"
    },
    {
      "type": "text",
      "id": "aside_button_label",
      "label": "Sidebar button",
      "default": "Call Us"
    },
    {
      "type": "url",
      "id": "aside_button_link",
      "label": "Sidebar button link"
    },
    {
      "type": "text",
      "id": "aside_button2_label",
      "label": "Sidebar second button",
      "default": "Email Us"
    },
    {
      "type": "url",
      "id": "aside_button2_link",
      "label": "Sidebar second button link"
    }
  ]
}
{% endschema %}

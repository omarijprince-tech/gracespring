{% layout 'password' %}
<div class="auth-layout" style="min-height:100vh;align-items:center">
  <div class="panel auth-panel" style="text-align:center">
    <div class="brand" style="justify-content:center;margin-bottom:18px">{% render 'brand' %}</div>
    {%- if shop.password_message != blank -%}<p style="color:var(--muted);margin-bottom:18px">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-msg err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="pw">{{ 'password.label' | t }}</label><input id="pw" type="password" name="password" autocomplete="current-password" required></div>
      <button class="btn btn-primary btn-block" type="submit" style="margin-top:14px">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

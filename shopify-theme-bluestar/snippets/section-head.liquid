{%- comment -%} Centered eyebrow / heading / text. Params: s (section.settings), light (on dark bg), align {%- endcomment -%}
{%- if s.eyebrow != blank or s.heading != blank or s.text != blank -%}
  <div class="section-head{% if align == 'left' %} left{% endif %}">
    {%- if s.eyebrow != blank -%}<span class="eyebrow"{% if light %} style="color:var(--sky-100)"{% endif %}>{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="section-sub">{{ s.text }}</div>{%- endif -%}
  </div>
{%- endif -%}

          <path class="w3" d="M0,320 L0,225.8 L24,224.5 L48,223.1 L72,221.6 L96,220.1 L120,218.5 L144,216.8 L168,215.1 L192,213.5 L216,211.8 L240,210.2 L264,208.6 L288,207.1 L312,205.7 L336,204.4 L360,203.2 L384,202.1 L408,201.2 L432,200.4 L456,199.8 L480,199.4 L504,199.1 L528,199.0 L552,199.1 L576,199.3 L600,199.7 L624,200.3 L648,201.1 L672,202.0 L696,203.0 L720,204.2 L744,205.5 L768,206.9 L792,208.4 L816,209.9 L840,211.5 L864,213.2 L888,214.9 L912,216.5 L936,218.2 L960,219.8 L984,221.4 L1008,222.9 L1032,224.3 L1056,225.6 L1080,226.8 L1104,227.9 L1128,228.8 L1152,229.6 L1176,230.2 L1200,230.6 L1224,230.9 L1248,231.0 L1272,230.9 L1296,230.7 L1320,230.3 L1344,229.7 L1368,228.9 L1392,228.0 L1416,227.0 L1440,225.8 L1464,224.5 L1488,223.1 L1512,221.6 L1536,220.1 L1560,218.5 L1584,216.8 L1608,215.1 L1632,213.5 L1656,211.8 L1680,210.2 L1704,208.6 L1728,207.1 L1752,205.7 L1776,204.4 L1800,203.2 L1824,202.1 L1848,201.2 L1872,200.4 L1896,199.8 L1920,199.4 L1944,199.1 L1968,199.0 L1992,199.1 L2016,199.3 L2040,199.7 L2064,200.3 L2088,201.1 L2112,202.0 L2136,203.0 L2160,204.2 L2184,205.5 L2208,206.9 L2232,208.4 L2256,209.9 L2280,211.5 L2304,213.2 L2328,214.9 L2352,216.5 L2376,218.2 L2400,219.8 L2424,221.4 L2448,222.9 L2472,224.3 L2496,225.6 L2520,226.8 L2544,227.9 L2568,228.8 L2592,229.6 L2616,230.2 L2640,230.6 L2664,230.9 L2688,231.0 L2712,230.9 L2736,230.7 L2760,230.3 L2784,229.7 L2808,228.9 L2832,228.0 L2856,227.0 L2880,225.8 L2880,320 Z"/>
          <path class="w4" d="M0,320 L0,261.4 L24,263.5 L48,264.7 L72,265.0 L96,264.3 L120,262.6 L144,260.3 L168,257.4 L192,254.3 L216,251.2 L240,248.6 L264,246.5 L288,245.3 L312,245.0 L336,245.7 L360,247.4 L384,249.7 L408,252.6 L432,255.7 L456,258.8 L480,261.4 L504,263.5 L528,264.7 L552,265.0 L576,264.3 L600,262.6 L624,260.3 L648,257.4 L672,254.3 L696,251.2 L720,248.6 L744,246.5 L768,245.3 L792,245.0 L816,245.7 L840,247.4 L864,249.7 L888,252.6 L912,255.7 L936,258.8 L960,261.4 L984,263.5 L1008,264.7 L1032,265.0 L1056,264.3 L1080,262.6 L1104,260.3 L1128,257.4 L1152,254.3 L1176,251.2 L1200,248.6 L1224,246.5 L1248,245.3 L1272,245.0 L1296,245.7 L1320,247.4 L1344,249.7 L1368,252.6 L1392,255.7 L1416,258.8 L1440,261.4 L1464,263.5 L1488,264.7 L1512,265.0 L1536,264.3 L1560,262.6 L1584,260.3 L1608,257.4 L1632,254.3 L1656,251.2 L1680,248.6 L1704,246.5 L1728,245.3 L1752,245.0 L1776,245.7 L1800,247.4 L1824,249.7 L1848,252.6 L1872,255.7 L1896,258.8 L1920,261.4 L1944,263.5 L1968,264.7 L1992,265.0 L2016,264.3 L2040,262.6 L2064,260.3 L2088,257.4 L2112,254.3 L2136,251.2 L2160,248.6 L2184,246.5 L2208,245.3 L2232,245.0 L2256,245.7 L2280,247.4 L2304,249.7 L2328,252.6 L2352,255.7 L2376,258.8 L2400,261.4 L2424,263.5 L2448,264.7 L2472,265.0 L2496,264.3 L2520,262.6 L2544,260.3 L2568,257.4 L2592,254.3 L2616,251.2 L2640,248.6 L2664,246.5 L2688,245.3 L2712,245.0 L2736,245.7 L2760,247.4 L2784,249.7 L2808,252.6 L2832,255.7 L2856,258.8 L2880,261.4 L2880,320 Z"/>
      </svg>
    </div>
  {%- endif -%}
  <div class="container hero-inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <{{ tag }} class="hero-title">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</{{ tag }}>
      {%- if section.settings.text != blank -%}<p class="hero-sub">{{ section.settings.text }}</p>{%- endif -%}
      {%- if promo != blank and section.settings.show_price -%}
        {%- assign v = promo.selected_or_first_available_variant -%}
        <div class="price-row hero-price">
          <span class="price-now">{{ v.price | money }}</span>
          {%- if v.compare_at_price > v.price -%}
            <span class="price-was">{{ v.compare_at_price | money }}</span>
            {%- assign saved = v.compare_at_price | minus: v.price | money_without_trailing_zeros -%}
            <span class="price-tag">{{ 'products.save' | t: amount: saved }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="hero-ctas">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn-primary" href="{{ primary_link | default: '#shop' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn-outline" href="{{ section.settings.button2_link | default: '#delivery' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="hero-chips">
          {%- for block in section.blocks -%}
            <span class="chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="hero-visual photo">
      {%- if visual != blank -%}
        {%- assign hero_alt = section.settings.image_alt | default: visual.alt | default: section.settings.heading -%}
        {%- if promo != blank and section.settings.image == blank -%}<a href="{{ promo.url }}" class="hero-visual-link">{%- endif -%}
        {%- if section.settings.heading_tag == 'h2' -%}
          {{ visual | image_url: width: 1120 | image_tag: widths: '400, 560, 800, 1120', sizes: '(max-width: 920px) 92vw, 560px', loading: 'lazy', alt: hero_alt }}
        {%- else -%}
          {{ visual | image_url: width: 1120 | image_tag: widths: '400, 560, 800, 1120', sizes: '(max-width: 920px) 92vw, 560px', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
        {%- endif -%}
        {%- if promo != blank and section.settings.image == blank -%}</a>{%- endif -%}
        {%- if promo != blank and section.settings.badge != blank -%}<span class="hero-badge">{{ section.settings.badge }}</span>{%- endif -%}
      {%- else -%}
        <img src="{{ 'hero-bottle.png' | asset_url }}" alt="{{ shop.name }}" width="522" height="982" style="max-width:300px;box-shadow:none;margin:0 auto" loading="eager">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "5-gallon water delivery · NJ & NYC"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure, clean water,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (accent color)",
      "default": "delivered to your door."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Blue Star brings 5-gallon bottles of purified, spring, and alkaline water to homes and offices across New Jersey and the five boroughs. Order online — we confirm your route and remind you every month."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Start Your Order"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Secondary button",
      "default": "Check Your Area"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Promote a product (bundle)"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Shows its price, links the main button to it and uses its photo when no image is set below."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on the photo",
      "default": "MEGA SALE"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)",
      "info": "Helps Google Images and screen readers. Empty uses the image's alt text from Files."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "gradient",
      "options": [
        {
          "value": "gradient",
          "label": "Soft gradient (Grace)"
        },
        {
          "value": "waves",
          "label": "Blue waves"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "wave_top",
      "label": "Waves: top color",
      "default": "#f2f9ff"
    },
    {
      "type": "color",
      "id": "wave_bottom",
      "label": "Waves: bottom color",
      "default": "#cfe8fb"
    },
    {
      "type": "color",
      "id": "wave_1",
      "label": "Waves: back wave",
      "default": "#9fd0f5"
    },
    {
      "type": "color",
      "id": "wave_2",
      "label": "Waves: middle wave",
      "default": "#4aa3e6"
    },
    {
      "type": "color",
      "id": "wave_3",
      "label": "Waves: front wave",
      "default": "#2280cc"
    },
    {
      "type": "range",
      "id": "wave_height",
      "label": "Waves: height",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "waves_animate",
      "label": "Waves: gentle movement",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "For the Image style. Use a wide photo, e.g. the blue-wave background from your product photos."
    },
    {
      "type": "range",
      "id": "background_overlay",
      "label": "Image: white overlay for readable text",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "H1 – main page title (use once per page)"
        },
        {
          "value": "h2",
          "label": "H2 – secondary banner"
        }
      ],
      "info": "Search engines expect one H1 per page."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "top"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "🚚 Next-day local delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "chip"
        }
      ]
    }
  ]
}
{% endschema %}

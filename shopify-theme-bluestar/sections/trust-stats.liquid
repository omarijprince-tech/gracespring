<section class="section section-tight"{% if section.settings.white_bg %} style="background:#fff"{% endif %}>
  <div class="container">
    {% render 'section-head', s: section.settings %}
    <div class="steps-grid trust-stats cols-grid"{% render 'grid-cols', desktop: section.settings.columns_desktop, mobile: section.settings.columns_mobile %}>
      {%- for block in section.blocks -%}
        <div class="step-card stat-card" {{ block.shopify_attributes }}>
          <div class="stat-value">{{ block.settings.value }}</div>
          <p>{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust stats",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "white_bg",
      "label": "White background",
      "default": true
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Big value",
          "default": "2010"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Serving NJ & NY since"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust stats",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}

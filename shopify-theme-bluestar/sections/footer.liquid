<footer class="site-footer">
  <div class="container">
    <div class="footer-grid cols-footer" style="--menu-cols: {{ section.blocks.size | at_least: 1 }}; --cols-mobile: {{ section.settings.columns_mobile | default: 1 }}">
      <div>
        <div class="footer-brand">{% render 'brand', on_dark: true %}</div>
        {%- if section.settings.tagline != blank -%}
          <p class="footer-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if settings.phone != blank -%}
          <p class="footer-tagline" style="margin-top:10px">☎ <a href="tel:{{ settings.phone | remove: '-' | remove: ' ' }}" style="color:inherit">{{ settings.phone }}</a></p>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign menu = linklists[block.settings.menu] -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading | default: menu.title }}</h4>
          <ul>
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</span>
      {%- if section.settings.bottom_text != blank -%}<span>{{ section.settings.bottom_text }}</span>{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Fresh 5-gallon purified, spring & alkaline water, delivered to homes and offices across NJ & NYC."
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom line text",
      "default": "A family water company serving NJ & NY since 2010."
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "info": "On desktop each link column block adds a column."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ]
}
{% endschema %}

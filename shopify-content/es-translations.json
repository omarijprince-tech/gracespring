    ["section.index.json.faq.question_1.answer:1phieg3x6viqp", "1292836f21e0dc79f8b555205b340695652c22c1debe4a3e0cfdb17f49a7e055", "<p>Entregamos agua en todo <strong>Nueva Jersey y Nueva York</strong>. Verifica tu código postal en la sección de entregas, o llámanos al <a href=\"tel:9737420435\">973-742-0435</a>.</p>"],
    ["section.index.json.faq.question_2.question:newpa3uysz8w", "9a95ab27bab59f0d1c015738509d013c86ec7e5eaecdb8f390d22e83ed8a4c3c", "¿Qué tipos de agua ofrecen?"],
    ["section.index.json.faq.question_2.answer:zo4m7b06n8v6", "215b4f1f719616dce3cac592d9e70e6f578805c07358ba3b0b30642ffda978c6", "<p>Agua <strong>purificada</strong>, <strong>alcalina</strong> y <strong>de manantial</strong> de manantiales naturales en Pensilvania — como recarga para tus botellas o en botellas nuevas. También tenemos agua alcalina ALKAID en paquetes de 12 × 1 L.</p>"],
    ["section.index.json.faq.question_3.question:1t026aq55wodt", "63abb2eb374b6c61543f2d611b5bae1edd7f0c4c88d2ec2d23ddce86bcea6e76", "¿En qué consiste la oferta del dispensador?"],
    ["section.index.json.faq.question_3.answer:z6yy7trt506b", "4328be3a4d6d47a1f61580bd5edf25647a235b7ec055ca7d57e8fc65edf4b31d", "<p>Nuestra MEGA OFERTA: compra un dispensador de agua y llévate <strong>5 botellas de agua purificada GRATIS + 1 estante GRATIS</strong> — hasta agotar existencias.</p>"],
    ["section.index.json.faq.question_4.question:3lw2nqq80gvli", "652b2b5632ecbd7d9d4ea3421ab73929668d13c7c3771581508552401fd260ba", "¿Recarga o botella nueva? ¿Cuál es la diferencia?"],
    ["section.index.json.faq.question_4.answer:18e28uakicgtg", "6b75c91b0fb9168419d75bd1c3c7cce209c823a35e2bead612d176f124b616eb", "<p>Elige <strong>Recarga</strong> para rellenar las botellas que ya tienes, o <strong>Botella nueva</strong> si necesitas garrafones nuevos de 5 galones.</p>"],
    ["section.index.json.faq.question_5.question:ekp195rws2k7", "792fc31f3095a1dae15a1e9c3d5aaae75a7ab4ca6b1689628807ddd3ed3262f2", "¿Cuál es su horario?"],
    ["section.index.json.faq.question_5.answer:2603x7bkvpp5x", "0d46069ea970322ad3a135688367f122469527eb13acc72845ce4613ffec5bee", "<p>Lunes a viernes de 8am a 6pm (hora del Este) · Sábado de 8am a 4pm.</p>"],
    ["section.index.json.faq.question_6.question:1yu1et9k2rcz8", "0ba8905818c5a73278aa010fe5fb13b534836f39b94166a0d74a920b7d96bee7", "¿Blue Star es una empresa con licencia?"],
    ["section.index.json.faq.question_6.answer:1g6q4yinvhfae", "241438fb4e5d16dfde6f8a9759a36cab1c33e47f26794d73a03f0f8409e02eb2", "<p>Sí. Desde 2010 purificamos, embotellamos y distribuimos agua en Nueva Jersey y Nueva York, y somos una empresa de entrega de agua con licencia del Departamento de Salud de Nueva Jersey (Consumer and Environmental Health Service).</p>"],
    ["section.index.json.faq.question_7.question:34f6vtvu9v245", "d5688ceb4baca73448e4b56527736a8fa89c46982efe84e98f4396699be9b72a", "¿Hablan español?"],
    ["section.index.json.faq.question_7.answer:1fpkgz1fhz6lj", "fe97106246a84c92f6697791680a1beb01ae61808ed391ea434b21cd253654c3", "<p>¡Sí! Hablamos español. Llámanos al <a href=\"tel:9737420435\">973-742-0435</a>.</p>"],

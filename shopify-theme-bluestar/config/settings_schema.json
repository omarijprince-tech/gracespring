[
  {
    "name": "theme_info",
    "theme_name": "Blue Star",
    "theme_version": "1.0.0",
    "theme_author": "Blue Star Pure Water",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Choose the same logo the previous theme used (it's already in your Files)."
      },
      {
        "type": "image_picker",
        "id": "logo_footer",
        "label": "Footer logo (optional)",
        "info": "Light version for the dark footer. Without one, the footer shows the brand name as text."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 32,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 60
      },
      {
        "type": "checkbox",
        "id": "logo_show_text",
        "label": "Show brand name next to the logo",
        "default": false,
        "info": "Leave off if the logo already includes the name."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "BLUE STAR"
      },
      {
        "type": "text",
        "id": "brand_sub",
        "label": "Brand tagline",
        "default": "Pure Water"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "phone",
        "label": "Phone number",
        "default": "973-742-0216"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Same structure as the Grace Spring palette. Defaults are the Blue Star blues."
      },
      {
        "type": "color",
        "id": "color_navy_900",
        "label": "Darkest (footer)",
        "default": "#0f2747"
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "Brand dark (headings, dark sections)",
        "default": "#1b3f73"
      },
      {
        "type": "color",
        "id": "color_blue",
        "label": "Primary (buttons, links)",
        "default": "#1f76bf"
      },
      {
        "type": "color",
        "id": "color_blue_600",
        "label": "Primary hover",
        "default": "#1b6aab"
      },
      {
        "type": "color",
        "id": "color_sky",
        "label": "Light accent (focus ring)",
        "default": "#8cc4ee"
      },
      {
        "type": "color",
        "id": "color_sky_100",
        "label": "Pale accent on dark",
        "default": "#d6eaf8"
      },
      {
        "type": "color",
        "id": "color_pale",
        "label": "Pale surfaces",
        "default": "#eaf4fc"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#f6fafd"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text",
        "default": "#13233a"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#5a6b80"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#d9e6f2"
      },
      {
        "type": "color",
        "id": "color_free",
        "label": "Gold accent (badges, cart count)",
        "default": "#f5a623"
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "text",
        "id": "deposit_tag",
        "label": "Deposit product tag",
        "default": "deposit",
        "info": "Products with this tag show the deposit badge."
      },
      {
        "type": "text",
        "id": "deposit_badge",
        "label": "Deposit badge text",
        "default": "+ $5 deposit"
      },
      {
        "type": "checkbox",
        "id": "card_show_description",
        "label": "Show description on product cards",
        "default": true
      },
      {
        "type": "header",
        "content": "Product images"
      },
      {
        "type": "select",
        "id": "product_image_style",
        "label": "Image style",
        "options": [
          { "value": "photo", "label": "Studio photo (fills the frame)" },
          { "value": "cutout", "label": "Cutout on blue gradient" }
        ],
        "default": "photo",
        "info": "Use studio photo for pictures with their own background; cutout for transparent PNGs."
      },
      {
        "type": "color",
        "id": "product_image_bg",
        "label": "Photo frame background",
        "default": "#f3f3f2",
        "info": "Match the background of your product photos."
      },
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "Product card image shape",
        "options": [
          { "value": "1 / 1", "label": "Square" },
          { "value": "4 / 3", "label": "Landscape (4:3)" },
          { "value": "4 / 5", "label": "Portrait (4:5)" }
        ],
        "default": "1 / 1"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      }
    ]
  },
  {
    "name": "SEO & business info",
    "settings": [
      {
        "type": "paragraph",
        "content": "Used for Google rich results (structured data) and link previews. Page titles and meta descriptions are edited per product/page in Shopify admin (Search engine listing)."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default share image",
        "info": "Shown when a page without its own image is shared (1200 × 630 px recommended)."
      },
      {
        "type": "select",
        "id": "business_type",
        "label": "Business type",
        "default": "LocalBusiness",
        "options": [
          {
            "value": "LocalBusiness",
            "label": "Local business"
          },
          {
            "value": "Store",
            "label": "Store"
          },
          {
            "value": "Organization",
            "label": "Organization (no address)"
          }
        ]
      },
      {
        "type": "text",
        "id": "business_email",
        "label": "Email",
        "default": "bluealkaiddistributor@gmail.com"
      },
      {
        "type": "text",
        "id": "business_street",
        "label": "Street address",
        "default": "527 E 39th St"
      },
      {
        "type": "text",
        "id": "business_city",
        "label": "City",
        "default": "Paterson"
      },
      {
        "type": "text",
        "id": "business_region",
        "label": "State",
        "default": "NJ"
      },
      {
        "type": "text",
        "id": "business_zip",
        "label": "ZIP code",
        "default": "07504"
      },
      {
        "type": "textarea",
        "id": "business_hours",
        "label": "Opening hours (one per line)",
        "default": "Mo-Fr 08:00-18:00\nSa 08:00-16:00",
        "info": "Format: Mo-Fr 08:00-18:00"
      },
      {
        "type": "text",
        "id": "business_areas",
        "label": "Areas served (comma separated)",
        "default": "New Jersey, New York"
      },
      {
        "type": "text",
        "id": "business_price_range",
        "label": "Price range",
        "default": "$"
      },
      {
        "type": "text",
        "id": "founding_year",
        "label": "Founded",
        "default": "2010"
      }
    ]
  }
]
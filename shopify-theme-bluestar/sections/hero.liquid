{%- liquid
  assign promo = section.settings.product
  assign tag = section.settings.heading_tag | default: 'h1'
  assign primary_link = section.settings.button_link
  if primary_link == blank and promo != blank
    assign primary_link = promo.url
  endif
  assign visual = section.settings.image
  if visual == blank and promo != blank
    assign visual = promo.featured_image
  endif
-%}
{%- assign bg = section.settings.background_style | default: 'gradient' -%}
<section class="hero hero-bg-{{ bg }}{% if promo != blank %} hero-promo{% endif %}{% if section.settings.waves_animate %} waves-animate{% endif %}" id="{{ section.settings.anchor | default: 'top' }}"
  style="--wave-top: {{ section.settings.wave_top }}; --wave-bottom: {{ section.settings.wave_bottom }}; --wave-1: {{ section.settings.wave_1 }}; --wave-2: {{ section.settings.wave_2 }}; --wave-3: {{ section.settings.wave_3 }}; --wave-height: {{ section.settings.wave_height }}%;{% if bg == 'image' and section.settings.background_image != blank %} --hero-bg-image: url('{{ section.settings.background_image | image_url: width: 2400 }}'); --hero-overlay: {{ section.settings.background_overlay | divided_by: 100.0 }};{% endif %}">
  {%- if bg == 'waves' -%}
    <div class="hero-waves" aria-hidden="true">
      <svg viewBox="0 0 2880 320" preserveAspectRatio="none" focusable="false">
          <path class="w1" d="M0,320 L0,120.0 L24,122.7 L48,125.4 L72,128.0 L96,130.6 L120,133.0 L144,135.3 L168,137.4 L192,139.3 L216,141.0 L240,142.5 L264,143.8 L288,144.7 L312,145.4 L336,145.9 L360,146.0 L384,145.9 L408,145.4 L432,144.7 L456,143.8 L480,142.5 L504,141.0 L528,139.3 L552,137.4 L576,135.3 L600,133.0 L624,130.6 L648,128.0 L672,125.4 L696,122.7 L720,120.0 L744,117.3 L768,114.6 L792,112.0 L816,109.4 L840,107.0 L864,104.7 L888,102.6 L912,100.7 L936,99.0 L960,97.5 L984,96.2 L1008,95.3 L1032,94.6 L1056,94.1 L1080,94.0 L1104,94.1 L1128,94.6 L1152,95.3 L1176,96.2 L1200,97.5 L1224,99.0 L1248,100.7 L1272,102.6 L1296,104.7 L1320,107.0 L1344,109.4 L1368,112.0 L1392,114.6 L1416,117.3 L1440,120.0 L1464,122.7 L1488,125.4 L1512,128.0 L1536,130.6 L1560,133.0 L1584,135.3 L1608,137.4 L1632,139.3 L1656,141.0 L1680,142.5 L1704,143.8 L1728,144.7 L1752,145.4 L1776,145.9 L1800,146.0 L1824,145.9 L1848,145.4 L1872,144.7 L1896,143.8 L1920,142.5 L1944,141.0 L1968,139.3 L1992,137.4 L2016,135.3 L2040,133.0 L2064,130.6 L2088,128.0 L2112,125.4 L2136,122.7 L2160,120.0 L2184,117.3 L2208,114.6 L2232,112.0 L2256,109.4 L2280,107.0 L2304,104.7 L2328,102.6 L2352,100.7 L2376,99.0 L2400,97.5 L2424,96.2 L2448,95.3 L2472,94.6 L2496,94.1 L2520,94.0 L2544,94.1 L2568,94.6 L2592,95.3 L2616,96.2 L2640,97.5 L2664,99.0 L2688,100.7 L2712,102.6 L2736,104.7 L2760,107.0 L2784,109.4 L2808,112.0 L2832,114.6 L2856,117.3 L2880,120.0 L2880,320 Z"/>

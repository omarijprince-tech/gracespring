{%- comment -%} Main image + thumbnails. Params: product, root_id {%- endcomment -%}
<div class="product-gallery" data-gallery>
  <div class="product-gallery-main">
    {%- assign first = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
    {%- if first -%}
      {{ first | image_url: width: 1000 | image_tag: widths: '450, 700, 1000', sizes: '(max-width: 920px) 92vw, 560px', loading: 'lazy', class: 'main-image' }}
    {%- else -%}
      {% render 'bottle-svg' %}
    {%- endif -%}
  </div>
  {%- if product.media.size > 1 -%}
    <div class="product-thumbs">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <button type="button" class="{% if media.id == first.id %}active{% endif %}" data-thumb="{{ media | image_url: width: 1000 }}" data-media-id="{{ media.id }}" aria-label="{{ media.alt | default: product.title | escape }}">
            {{ media | image_url: width: 160 | image_tag: loading: 'lazy' }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

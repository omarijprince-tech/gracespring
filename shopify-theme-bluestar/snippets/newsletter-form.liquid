{%- assign form_id = 'newsletter-' | append: id -%}
{%- form 'customer', id: form_id, class: 'zip-form newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  {%- if form.posted_successfully? -%}
    <p class="form-msg ok" style="flex-basis:100%">{{ 'newsletter.success' | t }}</p>
  {%- else -%}
    {%- if form.errors -%}<p class="form-msg err" style="flex-basis:100%">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
    <label class="sr-only" for="nl-email-{{ id }}">{{ 'contact.email' | t }}</label>
    <input id="nl-email-{{ id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
    <button class="btn btn-primary" type="submit">{% if button != blank %}{{ button }}{% else %}{{ 'newsletter.subscribe' | t }}{% endif %}</button>
  {%- endif -%}
{%- endform -%}

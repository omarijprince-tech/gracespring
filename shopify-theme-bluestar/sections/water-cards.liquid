<section class="section"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}{% if section.settings.white_bg %} style="background:#fff"{% endif %}>
  <div class="container">
    {% render 'section-head', s: section.settings %}
    <div class="offers-grid water-cards cols-grid"{% render 'grid-cols', desktop: section.settings.columns_desktop, mobile: section.settings.columns_mobile %}>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="offer-card water-card{% if b.featured %} featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.badge != blank -%}<span class="offer-badge{% if b.badge_gold %} gold{% endif %}">{{ b.badge }}</span>{%- endif -%}
          {%- if b.image != blank -%}
            <div class="water-card-media">
              {{ b.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(max-width: 920px) 92vw, 33vw', loading: 'lazy' }}
            </div>
          {%- endif -%}
          <h3>{{ b.title }}</h3>
          {%- if b.subtitle != blank -%}<div class="offer-price">{{ b.subtitle }}</div>{%- endif -%}
          {%- if b.text != blank -%}<div class="water-card-text rte">{{ b.text }}</div>{%- endif -%}
          {%- if b.button_label != blank -%}
            <a class="btn {% if b.featured %}btn-primary{% else %}btn-outline{% endif %}" href="{{ b.button_link | default: '#' }}">{{ b.button_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cards",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our water"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spring, alkaline or purified?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "white_bg",
      "label": "White background",
      "default": false
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "checkbox",
          "id": "badge_gold",
          "label": "Gold badge",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "inline_richtext",
          "id": "subtitle",
          "label": "Big line"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}

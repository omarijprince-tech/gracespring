<div class="page-head container"><span class="eyebrow">{{ shop.name }}</span><h1>{{ section.settings.heading | default: blog.title }}</h1></div>
<section class="section" style="padding-top:36px">
  <div class="container">
    {%- paginate blog.articles by section.settings.per_page -%}
      <div class="articles-grid">
        {%- for article in blog.articles -%}
          {% render 'article-card', article: article, show_excerpt: section.settings.show_excerpt %}
        {%- else -%}
          <p class="empty-state" style="grid-column:1/-1">{{ 'blog.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the blog title." },
    { "type": "range", "id": "per_page", "label": "Posts per page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true }
  ]
}
{% endschema %}

<section class="section bg-{{ section.settings.background }}">
  <div class="container">
    {% render 'section-head', s: section.settings %}
    <div class="slideshow" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
      <div class="slideshow-track" data-slides>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="slide split{% if section.settings.image_position == 'right' %} media-right{% endif %}" {{ block.shopify_attributes }} aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}">
            <div class="split-media ratio-landscape">
              <div class="split-slide active">
                {%- if b.image != blank -%}
                  {{ b.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(max-width: 920px) 92vw, 50vw', loading: 'lazy' }}
                {%- else -%}<div class="placeholder-bg"></div>{%- endif -%}
              </div>
            </div>
            <div class="split-copy">
              {%- if b.badge != blank -%}<span class="chip">{{ b.badge }}</span>{%- endif -%}
              {%- if b.heading != blank -%}<h3 class="split-heading size-large">{{ b.heading }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<div class="rte split-text">{{ b.text }}</div>{%- endif -%}
              {%- if b.button_label != blank -%}<div class="hero-ctas"><a class="btn btn-primary" href="{{ b.button_link | default: '#' }}">{{ b.button_label }}</a></div>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="slideshow-nav">
          <button type="button" class="icon-btn rail-btn" data-slide-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <div class="slideshow-dots">
            {%- for block in section.blocks -%}
              <button type="button" data-slide-dot="{{ forloop.index0 }}" aria-label="{{ block.settings.heading | escape }}"{% if forloop.first %} class="active"{% endif %}>{{ block.settings.heading }}</button>
            {%- endfor -%}
          </div>
          <button type="button" class="icon-btn rail-btn" data-slide-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Slideshow with text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 7 },
    { "type": "select", "id": "background", "label": "Background", "default": "white", "options": [ { "value": "none", "label": "Page" }, { "value": "white", "label": "White" }, { "value": "pale", "label": "Pale blue" } ] }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "badge", "label": "Badge" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Slide heading" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "text", "id": "button_label", "label": "Button label" },
      { "type": "url", "id": "button_link", "label": "Button link" }
    ] }
  ],
  "presets": [ { "name": "Slideshow with text", "blocks": [ { "type": "slide" }, { "type": "slide" } ] } ]
}
{% endschema %}

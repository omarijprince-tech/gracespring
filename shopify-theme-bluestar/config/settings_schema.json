[
  {
    "name": "theme_info",
    "theme_name": "Blue Star",
    "theme_version": "1.0.0",
    "theme_author": "Blue Star Pure Water",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Choose the same logo the previous theme used (it's already in your Files)."
      },
      {
        "type": "image_picker",
        "id": "logo_footer",
        "label": "Footer logo (optional)",
        "info": "Light version for the dark footer. Without one, the footer shows the brand name as text."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 32,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 52
      },
      {
        "type": "checkbox",
        "id": "logo_show_text",
        "label": "Show brand name next to the logo",
        "default": false,
        "info": "Leave off if the logo already includes the name."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "BLUE STAR"
      },
      {
        "type": "text",
        "id": "brand_sub",
        "label": "Brand tagline",
        "default": "Pure Water"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "phone",
        "label": "Phone number",
        "default": "973-742-0435"
      },
      {
        "type": "text",
        "id": "email",
        "label": "Email",
        "default": "bluealkaiddistributor@gmail.com"
      },
      {
        "type": "text",
        "id": "address",
        "label": "Address",
        "default": "527 E 39th St, Paterson, NJ 07504"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Grace Spring palette structure with the Blue Star brand blues (#2280cc / #102252) from the current site."
      },
      {
        "type": "color",
        "id": "color_navy_900",
        "label": "Darkest (footer)",
        "default": "#0b1a3d"
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "Brand dark (headings, dark sections)",
        "default": "#102252"
      },
      {
        "type": "color",
        "id": "color_blue",
        "label": "Primary (buttons, links)",
        "default": "#2280cc"
      },
      {
        "type": "color",
        "id": "color_blue_600",
        "label": "Primary hover",
        "default": "#1b6aab"
      },
      {
        "type": "color",
        "id": "color_sky",
        "label": "Light accent (focus ring)",
        "default": "#8cc4ee"
      },
      {
        "type": "color",
        "id": "color_sky_100",
        "label": "Pale accent on dark",
        "default": "#d6eaf8"
      },
      {
        "type": "color",
        "id": "color_pale",
        "label": "Pale surfaces",
        "default": "#eaf4fc"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#f6fafd"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text",
        "default": "#13233a"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#5a6b80"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders",
        "default": "#d9e6f2"
      },
      {
        "type": "color",
        "id": "color_free",
        "label": "Gold accent (badges, cart count)",
        "default": "#f5a623"
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "text",
        "id": "deposit_tag",
        "label": "Deposit product tag",
        "default": "deposit",
        "info": "Products with this tag show the deposit badge."
      },
      {
        "type": "text",
        "id": "deposit_badge",
        "label": "Deposit badge text",
        "default": "+ $5 deposit"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL or username",
        "default": "bluestarpurewater"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  }
]
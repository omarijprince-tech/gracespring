<section class="section" id="{{ section.settings.anchor }}">
  <div class="container">
    {% render 'section-head', s: section.settings %}
    <div class="steps-grid">
      {%- for block in section.blocks -%}
        <div class="step-card" {{ block.shopify_attributes }}>
          <div class="step-num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "how" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Water delivery in three easy steps" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Choose your water" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Pick your bottles and add a cooler if you need one." }
    ] }
  ],
  "presets": [ { "name": "How it works", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}

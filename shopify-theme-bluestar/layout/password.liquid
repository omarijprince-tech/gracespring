<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600;700&family=Anton&family=Yellowtail&display=swap" rel="stylesheet">
    {%- style -%}
      :root {
        --navy-900: {{ settings.color_navy_900 }}; --navy: {{ settings.color_navy }}; --blue: {{ settings.color_blue }};
        --blue-600: {{ settings.color_blue_600 }}; --sky: {{ settings.color_sky }}; --sky-100: {{ settings.color_sky_100 }};
        --pale: {{ settings.color_pale }}; --bg: {{ settings.color_bg }}; --ink: {{ settings.color_ink }};
        --muted: {{ settings.color_muted }}; --line: {{ settings.color_line }}; --free: {{ settings.color_free }};
        --success: #0e8a5f; --success-bg: #e7f6ef; --radius: 14px; --radius-sm: 9px;
        --shadow: 0 8px 28px rgba(18, 41, 74, 0.1); --shadow-sm: 0 2px 10px rgba(18, 41, 74, 0.08);
        --font-head: "Poppins", "Segoe UI", system-ui, sans-serif; --font-body: "Inter", "Segoe UI", system-ui, sans-serif;
      }
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>

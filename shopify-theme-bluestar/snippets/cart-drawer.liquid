<div class="overlay" data-cart-overlay></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="{{ 'cart.title' | t }}" aria-hidden="true" tabindex="-1">
  <div class="cart-head">
    <h2>{{ 'cart.title' | t }}</h2>
    <button class="icon-btn" type="button" data-cart-close aria-label="{{ 'cart.close' | t }}">✕</button>
  </div>
  <div data-cart-contents>
    {% render 'cart-drawer-contents' %}
  </div>
</aside>

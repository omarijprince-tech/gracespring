<section class="section"{% if section.settings.white_bg %} style="background:#fff"{% endif %}>
  <div class="container">
    {% render 'section-head', s: section.settings %}
    {%- if section.settings.body != blank -%}<div class="rte page-content" style="padding:0">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p style="text-align:center;margin-top:24px"><a class="btn btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "textarea", "id": "text", "label": "Subheading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "white_bg", "label": "White background", "default": false }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}

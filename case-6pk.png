          <text x="34" y="76" textAnchor="middle" fontFamily="Poppins, sans-serif" fontWeight="700" fontSize="7.5" fill="#1b3f73">GRACE SPRING</text>
          <text x="34" y="84" textAnchor="middle" fontFamily="Inter, sans-serif" fontSize="4" fill="#2d7dd2" letterSpacing="0.5">9.5 pH</text>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid cols-{{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="footer-col footer-block-{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <div class="footer-brand">
                {%- if b.logo != blank -%}
                  {%- capture logo_style -%}max-width: {{ b.logo_width }}px{%- endcapture -%}
                  {{ b.logo | image_url: width: 480 | image_tag: alt: shop.name, class: 'footer-logo', style: logo_style }}
                {%- else -%}
                  {% render 'brand', on_dark: true %}
                {%- endif -%}
              </div>
              {%- if b.text != blank -%}<div class="footer-tagline">{{ b.text }}</div>{%- endif -%}
              {%- if b.show_contact -%}
                <ul class="footer-contact">
                  {%- if settings.phone != blank -%}<li>{% render 'icon', name: 'phone' %}<a href="tel:{{ settings.phone | remove: '-' | remove: ' ' }}">{{ settings.phone }}</a></li>{%- endif -%}
                  {%- if settings.email != blank -%}<li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>{%- endif -%}
                  {%- if settings.address != blank -%}<li>{% render 'icon', name: 'pin' %}<span>{{ settings.address }}</span></li>{%- endif -%}
                </ul>
              {%- endif -%}
              {%- if b.show_social -%}{% render 'social-links' %}{%- endif -%}
            {%- when 'menu' -%}
              {%- assign menu = linklists[b.menu] -%}
              <h4>{{ b.heading | default: menu.title }}</h4>
              <ul>
                {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
              </ul>
            {%- when 'text' -%}
              {%- if b.heading != blank -%}<h4>{{ b.heading }}</h4>{%- endif -%}
              <div class="footer-tagline">{{ b.text }}</div>
            {%- when 'newsletter' -%}
              {%- if b.heading != blank -%}<h4>{{ b.heading }}</h4>{%- endif -%}
              {%- if b.text != blank -%}<div class="footer-tagline" style="margin-bottom:6px">{{ b.text }}</div>{%- endif -%}
              {% render 'newsletter-form', id: block.id, button: b.button_label %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}{% if section.settings.bottom_text != blank %} · {{ section.settings.bottom_text }}{% endif %}</span>
      <div class="footer-bottom-right">
        {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'localization-form' -%}
            <label class="sr-only" for="ft-lang">{{ 'footer.language' | t }}</label>
            <select id="ft-lang" class="country-select dark" name="language_code" onchange="this.form.submit()">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
              {%- endfor -%}
            </select>
            <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- endform -%}
        {%- endif -%}
        {%- if section.settings.show_payment -%}
          <ul class="payment-icons" aria-label="{{ 'footer.payment' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "bottom_text", "label": "Bottom line text", "default": "A family water company serving NJ & NY since 2010." },
    { "type": "checkbox", "id": "show_language", "label": "Show language selector", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "brand", "name": "Logo & info", "limit": 1, "settings": [
      { "type": "image_picker", "id": "logo", "label": "Footer logo", "info": "Use a light logo for the dark footer. Empty shows the brand name." },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 170 },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "checkbox", "id": "show_contact", "label": "Show phone / email / address", "default": true },
      { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
    ] },
    { "type": "menu", "name": "Link column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "text", "name": "Text column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Hours" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>M–F 8am – 6pm</p>" }
    ] },
    { "type": "newsletter", "name": "Newsletter", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Don't miss out on sales!" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Subscribe with your email today!</p>" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
    ] }
  ]
}
{% endschema %}

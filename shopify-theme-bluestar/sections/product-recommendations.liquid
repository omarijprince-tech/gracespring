<section class="section bg-{{ section.settings.background }}" data-recommendations
         data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      {% render 'section-head', s: section.settings %}
      <div class="products-grid grid-{{ section.settings.columns }}">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product, compact: true %}
        {%- endfor -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <p class="section-cta"><a class="btn btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "paragraph", "content": "Shopify picks related products automatically." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Per row", "default": "4", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "background", "label": "Background", "default": "white", "options": [ { "value": "none", "label": "Page" }, { "value": "white", "label": "White" }, { "value": "pale", "label": "Pale blue" } ] }
  ]
}
{% endschema %}

{%- assign blog = section.settings.blog -%}
<section class="section bg-{{ section.settings.background }}">
  <div class="container">
    {% render 'section-head', s: section.settings %}
    <div class="articles-grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.limit -%}
          {% render 'article-card', article: article, show_excerpt: section.settings.show_excerpt %}
        {%- endfor -%}
      {%- else -%}
        <p class="empty-state" style="grid-column:1/-1">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <p class="section-cta"><a class="btn btn-outline" href="{{ section.settings.button_link | default: blog.url }}">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the blog" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Posts", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "background", "label": "Background", "default": "none", "options": [ { "value": "none", "label": "Page" }, { "value": "white", "label": "White" }, { "value": "pale", "label": "Pale blue" } ] }
  ],
  "presets": [ { "name": "Blog posts" } ]
}
{% endschema %}

<div class="order-confirm not-found">
  <div class="big-check" style="background:var(--pale);color:var(--blue)">?</div>
  <h1>{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'general.404_title' | t }}{% endif %}</h1>
  <p>{% if section.settings.text != blank %}{{ section.settings.text }}{% else %}{{ 'general.404_text' | t }}{% endif %}</p>
  {%- if section.settings.show_search -%}
    <form class="search-form not-found-search" action="{{ routes.search_url }}" method="get" role="search">
      <span class="search-form-icon">{% render 'icon', name: 'search' %}</span>
      <input type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn btn-primary" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  {%- endif -%}
  <div class="hero-ctas" style="justify-content:center">
    {%- if section.settings.button_label != blank -%}<a class="btn btn-primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
    {%- if section.settings.button2_label != blank -%}<a class="btn btn-outline" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty uses the translated default."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Empty uses the translated default."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Order Water"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Secondary button",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Secondary button link"
    }
  ]
}
{% endschema %}

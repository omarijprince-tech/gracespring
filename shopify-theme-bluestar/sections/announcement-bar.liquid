{%- if section.settings.text != blank -%}
  <div class="announce">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" style="color:inherit">{%- endif -%}
    {%- if section.settings.highlight != blank -%}<strong>{{ section.settings.highlight }}</strong> {% endif -%}
    {{ section.settings.text }}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "highlight", "label": "Highlighted text", "default": "New customer special:" },
    { "type": "text", "id": "text", "label": "Text", "default": "Buy 1 water cooler, get 5 bottles + a bottle stand FREE. · Se Habla Español" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}

<div class="container auth-layout">
  <div class="panel auth-panel">
    <div id="recover" hidden>
      <h2>{{ 'customer.recover_title' | t }}</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}<p class="form-msg ok">{{ 'customer.recover_sent' | t }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="form-msg err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="r-email">{{ 'contact.email' | t }}</label><input id="r-email" type="email" name="email" autocomplete="email" required></div>
        <button class="btn btn-primary btn-block" type="submit" style="margin-top:14px">{{ 'customer.submit' | t }}</button>
      {%- endform -%}
      <p style="margin-top:14px;text-align:center"><a href="#login" data-toggle-recover>{{ 'customer.cancel' | t }}</a></p>
    </div>
    <div id="login">
      <h2>{{ 'customer.login_title' | t }}</h2>
      {%- form 'customer_login' -%}
        {%- if form.errors -%}<div class="form-msg err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field" style="margin-bottom:12px"><label for="l-email">{{ 'contact.email' | t }}</label><input id="l-email" type="email" name="customer[email]" autocomplete="email" required></div>
        <div class="field"><label for="l-pw">{{ 'customer.password' | t }}</label><input id="l-pw" type="password" name="customer[password]" autocomplete="current-password" required></div>
        <button class="btn btn-primary btn-block" type="submit" style="margin-top:16px">{{ 'customer.sign_in' | t }}</button>
      {%- endform -%}
      <p style="margin-top:14px;text-align:center;font-size:0.9rem">
        <a href="#recover" data-toggle-recover>{{ 'customer.forgot' | t }}</a> ·
        <a href="{{ routes.account_register_url }}">{{ 'customer.create' | t }}</a>
      </p>
    </div>
  </div>
</div>

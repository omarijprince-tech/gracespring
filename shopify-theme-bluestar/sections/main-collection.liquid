<div class="page-head container">
  <span class="eyebrow">{{ shop.name }}</span>
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
</div>
<section class="section" style="padding-top:36px">
  <div class="container">
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="products-grid cols-grid"{% render 'grid-cols', desktop: section.settings.columns_desktop, mobile: section.settings.columns_mobile %}>
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="empty-state" style="grid-column:1/-1">{{ 'collections.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ]
}
{% endschema %}
